---
import {load,url} from '../lib/content.js';
import {postCategoryName} from '../lib/catalog.js';
import {plainExcerpt} from '../lib/excerpt-text.js';
const posts=[...load('posts')].sort((a,b)=>String(b.date||'').localeCompare(String(a.date||''))).slice(0,4);
const strip=plainExcerpt;
---
{posts.length>0&&<div class="stgb-blogs__grid">
 {posts.map(p=><a class="stgb-blogs__item" href={url(p.slug)}>
   <div class="stgb-blogs__item-img">{p.featuredImage?<img src={p.featuredImage} alt={p.featuredAlt||p.title} loading="lazy" decoding="async"/>:<span class="stgb-blogs__featured-placeholder" aria-hidden="true"></span>}</div>
   <div class="stgb-blogs__item-body"><span class="stgb-blogs__item-cat">{postCategoryName(p)}</span><h3>{p.title}</h3><p>{strip(p.excerpt||p.content).slice(0,155)}</p><span class="stgb-blogs__item-more">Read Article →</span></div>
 </a>)}
</div>}