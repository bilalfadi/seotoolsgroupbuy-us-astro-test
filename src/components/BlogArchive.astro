---
import SiteLayout from '../layouts/SiteLayout.astro';
import {load,url} from '../lib/content.js';
import labels from '../lib/site-default-copy.json';
import {postCategories,postCategoryName,postCategoryTags} from '../lib/catalog.js';
import {trimWordExcerpt} from '../lib/legacy-render.js';
const posts=[...load('posts')].sort((a,b)=>String(b.date||'').localeCompare(String(a.date||'')));
const {pageNumber=1}=Astro.props;
const perPage=10;
const pageCount=Math.max(1,Math.ceil(posts.length/perPage));
const currentPage=Math.min(pageCount,Math.max(1,Number(pageNumber)||1));
const pagePosts=posts.slice((currentPage-1)*perPage,currentPage*perPage);
const pageUrl=n=>n===1?'/category/seo-tools-blog/':`/category/seo-tools-blog/page/${n}/`;
const categories=[...new Map(posts.flatMap(postCategories).filter(c=>c.slug).map(c=>[c.slug,{slug:c.slug,label:c.name}])).values()].sort((a,b)=>a.label.localeCompare(b.label));
const strip=(s='')=>String(s).replace(/<[^>]+>/g,' ').replace(/&[^;]+;/g,' ').replace(/\s+/g,' ').trim();
const fmt=(date)=>{const d=new Date(date);return Number.isNaN(d.getTime())?'':d.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})};
---
<SiteLayout title="Blogs - SEO Tips & Guides | SEO Tools Group Buy" description="Expert SEO tools guides, reviews and practical tips." canonical="/category/seo-tools-blog/" type="archive">
<section class="stgb-blog-archive-hero" aria-label="Blog">
 <div class="stgb-blog-archive-hero__bg"><div class="stgb-blog-archive-hero__glow stgb-blog-archive-hero__glow--1"></div><div class="stgb-blog-archive-hero__glow stgb-blog-archive-hero__glow--2"></div><div class="stgb-blog-archive-hero__dots"></div><div class="stgb-blog-archive-hero__float stgb-blog-archive-hero__float--1"></div><div class="stgb-blog-archive-hero__float stgb-blog-archive-hero__float--2"></div><div class="stgb-blog-archive-hero__float stgb-blog-archive-hero__float--3"></div></div>
 <div class="stgb-container stgb-blog-archive-hero__inner"><div class="stgb-blog-archive-hero__grid"><div class="stgb-blog-archive-hero__copy">
 <div class="stgb-blog-archive-hero__badge"><span class="stgb-blog-archive-hero__badge-dot"></span><span>{labels.blog_badge}</span></div>
 <h1 class="stgb-blog-archive-hero__title">{labels.blog_title_1} <span class="stgb-blog-archive-hero__title-accent">{labels.blog_title_2}</span> <span class="stgb-blog-archive-hero__title-line">{labels.blog_title_3}</span></h1>
 <p class="stgb-blog-archive-hero__desc">{labels.blog_desc}</p>
 <div class="stgb-blog-archive-hero__stats"><div class="stgb-blog-archive-hero__stat"><span class="stgb-blog-archive-hero__stat-icon">★</span><span>{labels.blog_stat1}</span></div><div class="stgb-blog-archive-hero__stat"><span class="stgb-blog-archive-hero__stat-icon">✓</span><span>{labels.blog_stat2}</span></div><div class="stgb-blog-archive-hero__stat"><span class="stgb-blog-archive-hero__stat-icon">⚡</span><span>{labels.blog_stat3}</span></div></div></div>
 <div class="stgb-blog-archive-hero__topics">
 {[
 ['🔍',labels.blog_topic1_title,labels.blog_topic1_desc],
 ['🛠️',labels.blog_topic2_title,labels.blog_topic2_desc],
 ['💡',labels.blog_topic3_title,labels.blog_topic3_desc],
 ['📊',labels.blog_topic4_title,labels.blog_topic4_desc]].map(t=><div class="stgb-blog-archive-hero__topic"><span class="stgb-blog-archive-hero__topic-icon">{t[0]}</span><h2 class="stgb-blog-archive-hero__topic-title">{t[1]}</h2><p>{t[2]}</p></div>)}
 </div></div></div>
 <div class="stgb-blog-archive-hero__wave" aria-hidden="true"><svg viewBox="0 0 1440 120" fill="none"><path d="M0 60L48 65C96 70 192 80 288 85C384 90 480 90 576 82.5C672 75 768 60 864 52.5C960 45 1056 45 1152 52.5C1248 60 1344 75 1392 82.5L1440 90V120H1392C1344 120 1248 120 1152 120C1056 120 960 120 864 120C768 120 672 120 576 120C480 120 384 120 288 120C192 120 96 120 48 120H0V60Z" fill="url(#stgb-blog-wave-gradient)"/><defs><linearGradient id="stgb-blog-wave-gradient" x1="0" y1="0" x2="1440" y2="0" gradientUnits="userSpaceOnUse"><stop stop-color="#f8fafc"/><stop offset="0.5" stop-color="#ffffff"/><stop offset="1" stop-color="#ecfdf5"/></linearGradient></defs></svg></div>
</section>
<section class="stgb-blog-archive-toolbar"><div class="stgb-container"><div class="stgb-blog-archive-toolbar__card">
<label class="stgb-blog-archive-toolbar__search" for="stgb-blog-search"><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg><input id="stgb-blog-search" type="search" placeholder="Search articles..." autocomplete="off"/></label>
<div class="stgb-blog-archive-toolbar__cats" role="tablist" aria-label="Filter articles">{[['all','All Posts'],['seo','SEO Tools'],['tutorial','Tutorials'],['review','Reviews'],['tips','Tips & Tricks']].map(([slug,label])=><button type="button" data-filter={slug} class:list={[slug==='all'&&'is-active']}>{label}</button>)}</div>
</div></div></section>
<div class="stgb-container"><div class="stgb-blog-archive-grid" id="stgb-blog-archive-grid">
{pagePosts.map(p=>{const plain=strip(p.excerpt||p.content);const excerpt=trimWordExcerpt(p.excerpt||p.content,24);const cat=postCategoryName(p);const searchTags=postCategoryTags(p);const filterCategories=postCategories(p).map(c=>c.slug).filter(Boolean).join('|');return <article class="stgb-blog-archive-card" data-title={p.title} data-excerpt={excerpt} data-tags={searchTags+' '+filterCategories}>
<a href={url(p.slug)} class="stgb-blog-archive-card__link"><div class="stgb-blog-archive-card__img">{p.featuredImage?<img src={p.featuredImage} loading="lazy" alt={p.featuredAlt||p.title}/>:<div class="stgb-blogs__featured-placeholder"></div>}</div><div class="stgb-blog-archive-card__body"><div class="stgb-blog-archive-card__meta"><span class="stgb-blog-archive-card__cat">{cat}</span><span>{fmt(p.date)}</span></div><h2>{p.title}</h2><p class="stgb-blog-archive-card__excerpt">{excerpt}</p><div class="stgb-blog-archive-card__footer"><span>{Math.max(1,Math.ceil(strip(p.content).split(/\s+/).length/200))} min read</span><span class="stgb-blog-archive-card__more">Read article →</span></div></div></a>
</article>})}
<p class="stgb-blog-archive-empty is-hidden">No articles match your search yet.</p>
</div></div>
{pageCount>1&&<nav class="stgb-blog-pagination" aria-label="Blog pages">{currentPage>1&&<a href={pageUrl(currentPage-1)} rel="prev">← Previous</a>}{Array.from({length:pageCount},(_,i)=>i+1).map(n=><a href={pageUrl(n)} aria-current={n===currentPage?'page':undefined} class:list={[n===currentPage&&'is-current']}>{n}</a>)}{currentPage<pageCount&&<a href={pageUrl(currentPage+1)} rel="next">Next →</a>}</nav>}
</SiteLayout>