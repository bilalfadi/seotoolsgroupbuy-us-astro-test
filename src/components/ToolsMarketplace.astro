---
import {load,url} from '../lib/content.js';
import labels from '../lib/site-default-copy.json';
import {productPrice,formatProductPrice,productCategories,productCategoryName} from '../lib/catalog.js';
import {productLogoData} from '../lib/legacy-render.js';
const products=load('products').sort((a,b)=>a.title.localeCompare(b.title));
const tabs=[[labels.tools_tab_all,'all'],[labels.tools_tab_seo,'seo'],[labels.tools_tab_content,'content'],[labels.tools_tab_amazon,'amazon'],[labels.tools_tab_design,'design'],[labels.tools_tab_ai,'ai']];
const tab=p=>{
  let cats=String(productCategories(p)[0]||'').toLowerCase(),name=String(p.title||'').toLowerCase();
  if(cats.includes('seo'))return 'seo';
  if(cats.includes('content'))return 'content';
  if(cats.includes('amazon'))return 'amazon';
  if(cats.includes('design'))return 'design';
  if(cats.includes('ai'))return 'ai';
  if(/ahrefs|semrush|moz|ubersuggest|majestic|backlink|keyword|seo/.test(name))return 'seo';
  if(/amazon|helium|jungle|seller|ecomhunt|ebay|etsy/.test(name))return 'amazon';
  if(/canva|envato|depositphotos|storyblocks|videoblocks|design|graphic|stock|animation/.test(name))return 'design';
  if(/chatgpt|midjourney|gamma|elevenlabs|ai|claude|perplexity|copilot/.test(name))return 'ai';
  if(/grammarly|quetext|copyscape|frase|content|writer/.test(name))return 'content';
  // Match the original WordPress classifier: unmatched tools fall back to SEO.
  return 'seo';
};
const formatPrice=p=>String(p.salePrice||p.price||'').replace(/^\$/,'');
---
<div class="stgb-tools-list-page" data-static-marketplace>
 <div class="stgb-container stgb-tools-list-page__inner">
  <div class="stgb-tools-list-hero stgb-reveal"><div class="stgb-tools-list-hero__text"><p class="stgb-tools-list-hero__eyebrow">{labels.tools_eyebrow}</p><h1 class="stgb-tools-list-hero__title">{labels.tools_title}</h1><p class="stgb-tools-list-hero__desc">{labels.tools_desc}</p></div><div class="stgb-tools-list-stats"><div><strong>{labels.tools_stat1_value}</strong><span>{labels.tools_stat1_label}</span></div><div><strong>{labels.tools_stat2_value}</strong><span>{labels.tools_stat2_label}</span></div><div><strong>{labels.tools_stat3_value}</strong><span>{labels.tools_stat3_label}</span></div></div></div>
  <nav class="stgb-tools-list-tabs stgb-reveal" aria-label="Tool categories">{tabs.map(([label,id])=><a href={id==='all'?'?':'?tab='+id} data-static-tab={id} class:list={['stgb-tools-list-tab',id==='all'&&'is-active']}>{label}</a>)}</nav>
  <div class="woocommerce stgb-tools-marketplace-grid-wrap"><ul class="products stgb-tools-list-grid stgb-product-card-grid" data-static-grid>{products.map(p=>{const price=productPrice(p);const logo=productLogoData(p.title);return <li class="stgb-product-card-item product type-product" data-static-card data-tab={tab(p)}><a href={url(p.slug)} class="stgb-related-card stgb-product-card"><div class="stgb-related-card__inner">{price.onSale&&<span class="stgb-related-card__badge">{Math.round((1-Number(price.sale)/Number(price.regular))*100)}% OFF</span>}<div class="stgb-related-card__media">{p.featuredImage?<img class="stgb-related-card__img" src={p.featuredImage} alt={p.featuredAlt||p.title} loading="lazy" decoding="async"/>:<div class="stgb-related-card__fallback" style={`background-color:${logo.color}`}>{logo.initials}</div>}</div><div class="stgb-related-card__divider"></div><div class="stgb-related-card__body"><span class="stgb-related-card__category">{productCategoryName(p).toUpperCase()}</span><h3 class="stgb-related-card__name">{p.title}</h3><div class="stgb-related-card__pricing"><div class="stgb-related-card__price-wrap"><span class="stgb-related-card__price">{price.current?formatProductPrice(price.current):'Contact us'}</span><span class="stgb-related-card__per">{labels.price_suffix_card||'/mo'}</span></div>{price.onSale&&<span class="stgb-related-card__old">{formatProductPrice(price.regular)}</span>}</div><span class="stgb-related-card__cta">{labels.market_view_details} <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></span></div></div></a></li>})}</ul>
  <div class="stgb-tools-list-load-more-wrap" data-static-more-wrap><button type="button" class="stgb-btn stgb-btn--teal stgb-tools-list-load-more" data-static-more>{labels.market_load_more}</button></div></div>
  <div class="stgb-tools-list-support stgb-reveal"><h2>{labels.tools_support_title}</h2><p>{labels.tools_support_text}</p><div class="stgb-tools-list-support__btns"><a href="https://wa.me/15205636362" class="stgb-btn stgb-btn--teal" target="_blank" rel="noopener noreferrer">{labels.tools_support_wa}</a><a href="/pricing-plans/" class="stgb-btn stgb-btn--orange">{labels.tools_support_pricing}</a></div></div>
 </div>
</div>
