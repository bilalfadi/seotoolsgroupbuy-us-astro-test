---
import {url} from '../lib/content.js';
const {entry}=Astro.props;
const formatDate=(raw)=>{const d=new Date(raw);return Number.isNaN(d.getTime())?'':new Intl.DateTimeFormat('en-US',{year:'numeric',month:'long',day:'numeric'}).format(d)};
const cats=String(entry.categories||'');
const firstCategory=(cats.match(/'name': '([^']+)'/)||[])[1]||'SEO Tools Blog';
const author=entry.author||'Editorial team';
---
<article class="stgb-post-article">
 <section class="stgb-post-hero" aria-label="Article header"><div class="stgb-container"><div class="stgb-post-hero__inner"><p class="stgb-post-hero__cat">{firstCategory}</p><h1 class="stgb-post-hero__title">{entry.title}</h1><div class="stgb-post-hero__meta"><span>{formatDate(entry.date)}</span><span class="stgb-post-hero__meta-sep" aria-hidden="true">•</span><span>By {author}</span></div><p class="stgb-post-hero__tagline">We test every group-buy seat, benchmark pricing weekly, and publish the findings so your team knows exactly what to expect.</p></div></div></section>
 <section class="stgb-container stgb-post-detail-body" id="stgb-post-detail-section"><div class="stgb-post-layout" id="stgb-post-detail-content"><div class="stgb-post-content-shell"><div class="stgb-post-content prose-rich post-detail-content" set:html={entry.content}/></div><aside class="stgb-post-sidebar"><div class="stgb-author-card"><p class="stgb-author-card__label">About the author</p><div class="stgb-author-card__body"><div class="stgb-author-card__info"><p class="stgb-author-card__name">{author}</p><p class="stgb-author-card__role">Editorial team <span> · SEO Tools Group Buy</span></p></div></div></div><a href="/category/seo-tools-blog/" class="stgb-post-sidebar__cta">Browse all blogs</a></aside></div></section>
</article>
