---
import labels from '../lib/site-default-copy.json';
import fallback from '../lib/faq-defaults.json';
import {home} from '../lib/content.js';
const {entry}=Astro.props;
const kind=entry.slug==='pricing-plans'?'pricing':entry.slug==='contact'?'contact':entry.slug==='frequently-asked-questions-faqs-for-an-seo-group-buy'?'faq':'default';
const hero={pricing:{cls:'stgb-hero--violet',icon:'💎',badge:labels.pricing_badge,title:labels.pricing_title,subtitle:labels.pricing_subtitle},contact:{cls:'stgb-hero--emerald',icon:'💬',badge:labels.contact_badge,title:labels.contact_title,subtitle:labels.contact_subtitle},faq:{cls:'stgb-hero--faq',icon:'❓',badge:labels.faq_badge,title:entry.title,subtitle:labels.faq_subtitle}};
const h=hero[kind];
const pricingHtml=entry.content||'';
const urlWhatsApp='https://wa.me/447845432224';
const urlMessenger='https://m.me/108606453898810';
---
{kind==='default'?<div class="stgb-page-wrap stgb-page-bg--default"><section class="stgb-page-default-hero stgb-reveal"><div class="stgb-page-default-hero__bg"></div><div class="stgb-container stgb-page-default-hero__inner"><div class="stgb-page-badge stgb-page-badge--dark"><span>Page</span></div><h1 class="stgb-page-default-hero__title">{entry.title}</h1></div></section><section class="stgb-page-default-main stgb-reveal"><div class="stgb-container"><div class="stgb-page-default-layout"><article class="stgb-page-content-box"><div class="stgb-page-content-box__bar stgb-bar--emerald"></div><div class="stgb-page-content-box__inner"><div class="prose-rich stgb-page-prose stgb-prose--emerald" set:html={entry.content}/></div></article><aside class="stgb-page-default-sidebar"><div class="stgb-page-sidebar-box stgb-page-sidebar-box--emerald"><h3>{labels.default_side_title}</h3><p>{labels.default_side_text}</p><a href="/contact/" class="stgb-page-sidebar-btn">{labels.default_side_btn}</a></div><div class="stgb-page-sidebar-box stgb-page-sidebar-box--light"><h4>{labels.default_links_title}</h4><ul class="stgb-page-sidebar-links"><li><a href="/pricing-plans/">Pricing Plans</a></li><li><a href="/single-tools-list/">Tools List</a></li><li><a href="/shop/">Shop</a></li></ul></div></aside></div></div></section></div>:
 <div class:list={['stgb-page-wrap','stgb-page-bg--'+kind]}><section class="stgb-page-hero-section stgb-reveal"><div class:list={['stgb-page-hero-bg',h.cls]}><div class="stgb-page-hero-blob stgb-page-hero-blob--1"></div><div class="stgb-page-hero-blob stgb-page-hero-blob--2"></div><div class="stgb-page-hero-grid"></div></div><div class="stgb-container stgb-page-hero-inner"><div class="stgb-page-badge"><span class="stgb-page-badge__icon">{h.icon}</span><span>{h.badge}</span></div><h1 class="stgb-page-hero-title">{h.title}</h1><p class="stgb-page-hero-subtitle">{h.subtitle}</p></div></section>
 {kind==='pricing'?<><div class="stgb-pricing-page-section stgb-reveal" set:html={pricingHtml}/><section class="stgb-page-chat-section stgb-reveal"><div class="stgb-container"><div class="stgb-page-chat-box"><div class="stgb-page-chat-box__bar"></div><div class="stgb-page-chat-box__inner"><div class="stgb-page-chat-box__head"><h2>{labels.pricing_chat_title}</h2><p>{labels.pricing_chat_text}</p></div><div class="stgb-page-chat-grid"><a href={urlMessenger} class="stgb-page-chat-card stgb-page-chat-card--fb" target="_blank" rel="noopener noreferrer"><div class="stgb-page-chat-card__icon">💬</div><h3>{labels.pricing_fb_title}</h3><p>{labels.pricing_fb_text}</p><span>{labels.pricing_fb_cta}</span></a><a href={urlWhatsApp} class="stgb-page-chat-card stgb-page-chat-card--wa" target="_blank" rel="noopener noreferrer"><div class="stgb-page-chat-card__icon">📱</div><h3>{labels.pricing_wa_title}</h3><p>{labels.pricing_wa_text}</p><span>{labels.pricing_wa_cta}</span></a></div></div></div></div></section></>:
 kind==='contact'?<><section class="stgb-page-contact-cards stgb-reveal"><div class="stgb-container"><div class="stgb-page-contact-grid"><a href={urlWhatsApp} class="stgb-page-contact-card" target="_blank" rel="noopener noreferrer"><div class="stgb-page-contact-card__icon stgb-page-contact-card__icon--wa">📱</div><h3>{labels.contact_wa_title}</h3><p>{labels.contact_wa_text}</p><span class="stgb-page-contact-card__link">{labels.contact_wa_cta}</span></a><a href="mailto:support@seotoolsgroupbuy.us" class="stgb-page-contact-card"><div class="stgb-page-contact-card__icon stgb-page-contact-card__icon--email">✉️</div><h3>{labels.contact_email_title}</h3><p>{labels.contact_email_text}</p><span class="stgb-page-contact-card__link stgb-page-contact-card__link--orange">{labels.contact_email_cta}</span></a><a href="/tools-status/" class="stgb-page-contact-card"><div class="stgb-page-contact-card__icon stgb-page-contact-card__icon--status">📊</div><h3>{labels.contact_status_title}</h3><p>{labels.contact_status_text}</p><span class="stgb-page-contact-card__link stgb-page-contact-card__link--slate">{labels.contact_status_cta}</span></a></div></div></section><section class="stgb-page-contact-main stgb-reveal"><div class="stgb-container"><div class="stgb-page-contact-layout"><div class="stgb-page-contact-content"><div class="stgb-page-content-box"><div class="stgb-page-content-box__bar stgb-bar--emerald"></div><div class="stgb-page-content-box__inner"><div class="stgb-page-contact-block"><h3>{labels.contact_abuse_title}</h3><p>{labels.contact_abuse_text?.replace('{admin_email}','admin@seotoolsgroupbuy.us')}</p></div><div class="stgb-page-contact-block"><h3>{labels.contact_about_title}</h3><p>{labels.contact_about_text}</p></div></div></div></div><aside class="stgb-page-contact-sidebar"><div class="stgb-page-sidebar-box stgb-page-sidebar-box--emerald"><h3>{labels.contact_side_title}</h3><p>{labels.contact_side_sub}</p><p>{labels.contact_side_text}</p><ul><li>✓ {labels.contact_side_li1}</li><li>✓ {labels.contact_side_li2}</li><li>✓ {labels.contact_side_li3}</li></ul><a class="stgb-page-sidebar-btn" href={urlWhatsApp}>{labels.contact_side_btn}</a></div></aside></div></div></section></>:
 <div class="stgb-faq-page-body"><div class="stgb-container"><div class="stgb-faq-page-layout stgb-reveal"><aside class="stgb-faq-page-toc"><h3>{labels.faq_categories}</h3><nav><a href="#category-all"><span>❓</span>All Questions</a></nav></aside><div class="stgb-faq-page-content"><section id="category-all" class="stgb-faq-page-category"><h2>❓ All Questions</h2><div class="stgb-faq-page-list">{fallback.map((f,i)=><details class="stgb-faq-page-item" open={i===0}><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></section></div></div></div><section class="stgb-faq-page-support stgb-reveal"><div class="stgb-container"><div class="stgb-page-cta-inline stgb-cta--emerald"><div><h3>{labels.faq_cta_title}</h3><p>{labels.faq_cta_text}</p></div><a href="/contact/" class="stgb-page-cta-btn">{labels.faq_cta_btn}</a></div></div></section></div>}
 </div>}
