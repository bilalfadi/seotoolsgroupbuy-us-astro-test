---
import labels from '../lib/site-default-copy.json';
import PolicyPage from './PolicyPage.astro';
import contactSettings from '../../content/settings/contact.json';
import fallback from '../lib/faq-defaults.json';
import {home} from '../lib/content.js';
const {entry}=Astro.props;
const isPolicy=['dmca-policy','privacy-policy','refund-policy','terms-conditions'].includes(entry.slug);
const kind=entry.slug==='pricing-plans'?'pricing':entry.slug==='contact'?'contact':entry.slug==='frequently-asked-questions-faqs-for-an-seo-group-buy'?'faq':'default';
const hero={pricing:{cls:'stgb-hero--violet',icon:'💎',badge:labels.pricing_badge,title:labels.pricing_title,subtitle:labels.pricing_subtitle},contact:{cls:'stgb-hero--emerald',icon:'💬',badge:labels.contact_badge,title:labels.contact_title,subtitle:labels.contact_subtitle},faq:{cls:'stgb-hero--faq',icon:'❓',badge:labels.faq_badge,title:entry.title,subtitle:labels.faq_subtitle}};
const h=hero[kind];
const pricingHtml=entry.content||'';
const urlWhatsApp='https://wa.me/447845432224';
const urlMessenger='https://m.me/108606453898810';
const validEmail = value => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(value || '').trim());
const supportEmail = validEmail(contactSettings.supportEmail) ? contactSettings.supportEmail.trim() : '';
const adminEmail = validEmail(contactSettings.adminEmail) ? contactSettings.adminEmail.trim() : '';
const abuseParts = String(labels.contact_abuse_text || '').split('{admin_email}');
const faqCategories=[
  {id:'common',label:'Common Questions',icon:'❓'},
  {id:'getting-started',label:'Getting Started',icon:'🚀'},
  {id:'pricing',label:'Pricing & Plans',icon:'💰'},
  {id:'tools',label:'Tools & Features',icon:'🛠️'},
  {id:'support',label:'Support & Help',icon:'💬'},
  {id:'account',label:'Account & Access',icon:'👤'}
];
// Match WP stgb_faq_page_data(): Yoast HTML FAQ content takes precedence;
// otherwise use its categorized fallback data, never invent categories.
const parsedFaq=[...String(entry.content||'').matchAll(/<strong[^>]*class=["'][^"']*schema-faq-question[^"']*["'][^>]*>([\\s\\S]*?)<\\/strong>[\\s\\S]*?<p[^>]*class=["'][^"']*schema-faq-answer[^"']*["'][^>]*>([\\s\\S]*?)<\\/p>/gi)]
  .map(m=>({q:m[1].replace(/<[^>]+>/g,'').trim(),a:m[2].trim(),cat:'all',html:true}))
  .filter(x=>x.q&&x.a);
const faqGroups=parsedFaq.length?[{id:'all',label:'All Questions',icon:'❓'}]:faqCategories;
const faqItems=parsedFaq.length?parsedFaq:fallback;
const modifiedDate=entry.modified?new Date(entry.modified):null;
const formattedModified=modifiedDate&&!Number.isNaN(modifiedDate.getTime())?new Intl.DateTimeFormat('en-US',{month:'long',day:'numeric',year:'numeric'}).format(modifiedDate):'';
const plainExcerpt=String(entry.excerpt||'').replace(/<[^>]*>/g,' ').trim();
---
{isPolicy?<PolicyPage entry={entry}/>:kind==='default'?<div class="stgb-page-wrap stgb-page-bg--default"><section class="stgb-page-default-hero stgb-reveal"><div class="stgb-page-default-hero__bg"></div><div class="stgb-container stgb-page-default-hero__inner"><div class="stgb-page-badge stgb-page-badge--dark"><span>Page</span></div><h1 class="stgb-page-default-hero__title">{entry.title}</h1>{formattedModified&&<p class="stgb-page-default-meta">{formattedModified}</p>}</div><div class="stgb-page-wave"><svg viewBox="0 0 1440 120" fill="none" aria-hidden="true"><path d="M0 120L60 105C120 90 240 60 360 45C480 30 600 30 720 37.5C840 45 960 60 1080 67.5C1200 75 1320 75 1380 75L1440 75V120H0Z" fill="url(#default-wave)"/><defs><linearGradient id="default-wave" x1="0" y1="0" x2="1440" y2="0"><stop stop-color="#f8fafc"/><stop offset="1" stop-color="#f0fdf4"/></linearGradient></defs></svg></div></section><section class="stgb-page-default-main stgb-reveal"><div class="stgb-container"><div class="stgb-page-default-layout"><article class="stgb-page-content-box"><div class="stgb-page-content-box__bar stgb-bar--emerald"></div><div class="stgb-page-content-box__inner">{plainExcerpt&&<div class="stgb-page-excerpt"><p>{plainExcerpt}</p></div>}{entry.content?<div class="prose-rich stgb-page-prose stgb-prose--emerald" set:html={entry.content}/>:<p class="stgb-page-empty">No content available.</p>}</div></article><aside class="stgb-page-default-sidebar"><div class="stgb-page-sidebar-box stgb-page-sidebar-box--emerald"><h3>{labels.default_side_title}</h3><p>{labels.default_side_text}</p><a href="/contact/" class="stgb-page-sidebar-btn">{labels.default_side_btn}</a></div><div class="stgb-page-sidebar-box stgb-page-sidebar-box--light"><h4>{labels.default_links_title}</h4><ul class="stgb-page-sidebar-links"><li><a href="/pricing-plans/">Pricing Plans</a></li><li><a href="/single-tools-list/">Tools List</a></li><li><a href="/shop/">Shop</a></li></ul></div></aside></div></div></section></div>:
 <div class:list={['stgb-page-wrap','stgb-page-bg--'+kind]}><section class="stgb-page-hero-section stgb-reveal"><div class:list={['stgb-page-hero-bg',h.cls]}><div class="stgb-page-hero-blob stgb-page-hero-blob--1"></div><div class="stgb-page-hero-blob stgb-page-hero-blob--2"></div><div class="stgb-page-hero-grid"></div></div><div class="stgb-container stgb-page-hero-inner"><div class="stgb-page-badge"><span class="stgb-page-badge__icon">{h.icon}</span><span>{h.badge}</span></div><h1 class="stgb-page-hero-title">{h.title}</h1>{kind==='contact'&&labels.contact_tagline&&<p class="stgb-page-hero-tagline">{labels.contact_tagline}</p>}<p class="stgb-page-hero-subtitle">{h.subtitle}</p></div>{kind==='contact'&&<div class="stgb-page-wave"><svg viewBox="0 0 1440 120" fill="none" aria-hidden="true"><path d="M0 120L60 105C120 90 240 60 360 45C480 30 600 30 720 37.5C840 45 960 60 1080 67.5C1200 75 1320 75 1380 75L1440 75V120H0Z" fill="url(#contact-wave)"/><defs><linearGradient id="contact-wave" x1="0" y1="0" x2="1440" y2="0"><stop stop-color="#f8fafc"/><stop offset="1" stop-color="#ecfdf5"/></linearGradient></defs></svg></div>}</section>
 {kind==='pricing'?<><div class="stgb-pricing-page-section stgb-reveal" set:html={pricingHtml}/><section class="stgb-page-chat-section stgb-reveal"><div class="stgb-container"><div class="stgb-page-chat-box"><div class="stgb-page-chat-box__bar"></div><div class="stgb-page-chat-box__inner"><div class="stgb-page-chat-box__head"><h2>{labels.pricing_chat_title}</h2><p>{labels.pricing_chat_text}</p></div><div class="stgb-page-chat-grid"><a href={urlMessenger} class="stgb-page-chat-card stgb-page-chat-card--fb" target="_blank" rel="noopener noreferrer"><div class="stgb-page-chat-card__icon">💬</div><h3>{labels.pricing_fb_title}</h3><p>{labels.pricing_fb_text}</p><span>{labels.pricing_fb_cta}</span></a><a href={urlWhatsApp} class="stgb-page-chat-card stgb-page-chat-card--wa" target="_blank" rel="noopener noreferrer"><div class="stgb-page-chat-card__icon">📱</div><h3>{labels.pricing_wa_title}</h3><p>{labels.pricing_wa_text}</p><span>{labels.pricing_wa_cta}</span></a></div></div></div></div></section></>:
 kind==='contact'?<><section class="stgb-page-contact-cards stgb-reveal"><div class="stgb-container"><div class="stgb-page-contact-grid"><a href={urlWhatsApp} class="stgb-page-contact-card" target="_blank" rel="noopener noreferrer"><div class="stgb-page-contact-card__icon stgb-page-contact-card__icon--wa">📱</div><h3>{labels.contact_wa_title}</h3><p>{labels.contact_wa_text}</p><span class="stgb-page-contact-card__link">{labels.contact_wa_cta}</span></a><a href={urlMessenger} class="stgb-page-contact-card" target="_blank" rel="noopener noreferrer"><div class="stgb-page-contact-card__icon stgb-page-contact-card__icon--fb">💬</div><h3>{labels.contact_fb_title}</h3><p>{labels.contact_fb_text}</p><span class="stgb-page-contact-card__link stgb-page-contact-card__link--fb">{labels.contact_fb_cta}</span></a><a href={supportEmail ? `mailto:${supportEmail}` : undefined} class="stgb-page-contact-card"><div class="stgb-page-contact-card__icon stgb-page-contact-card__icon--email">✉️</div><h3>{labels.contact_email_title}</h3><p>{labels.contact_email_text}</p><span class="stgb-page-contact-card__link stgb-page-contact-card__link--orange">{labels.contact_email_cta}</span></a><a href="/tools-status/" class="stgb-page-contact-card"><div class="stgb-page-contact-card__icon stgb-page-contact-card__icon--status">📊</div><h3>{labels.contact_status_title}</h3><p>{labels.contact_status_text}</p><span class="stgb-page-contact-card__link stgb-page-contact-card__link--slate">{labels.contact_status_cta}</span></a></div></div></section><section class="stgb-page-contact-main stgb-reveal"><div class="stgb-container"><div class="stgb-page-contact-layout"><div class="stgb-page-contact-content"><div class="stgb-page-content-box"><div class="stgb-page-content-box__bar stgb-bar--emerald"></div><div class="stgb-page-content-box__inner"><div class="stgb-page-contact-block"><h3>{labels.contact_abuse_title}</h3><p>{abuseParts[0]}{adminEmail ? <a href={`mailto:${adminEmail}`}>{adminEmail}</a> : contactSettings.adminEmail}{abuseParts.slice(1).join('{admin_email}')}</p></div><div class="stgb-page-contact-block"><h3>{labels.contact_about_title}</h3><p>{labels.contact_about_text}</p></div></div></div></div><aside class="stgb-page-contact-sidebar"><div class="stgb-page-sidebar-box stgb-page-sidebar-box--emerald"><div class="stgb-page-sidebar-box__head"><span>💬</span><div><h3>{labels.contact_side_title}</h3><p>{labels.contact_side_sub}</p></div></div><p>{labels.contact_side_text}</p><ul><li>✓ {labels.contact_side_li1}</li><li>✓ {labels.contact_side_li2}</li><li>✓ {labels.contact_side_li3}</li></ul><a class="stgb-page-sidebar-btn" href={urlWhatsApp} target="_blank" rel="noopener noreferrer">{labels.contact_side_btn}</a></div><div class="stgb-page-sidebar-box stgb-page-sidebar-box--light"><h4>{labels.contact_address_title}</h4><p><strong>{labels.contact_address_label}</strong><br/>{contactSettings.mailingAddress}</p><p><strong>{labels.contact_phone_label}</strong><br/>{contactSettings.phone}</p></div></aside></div></div></section><section class="stgb-page-contact-cta stgb-reveal"><div class="stgb-container"><div class="stgb-page-cta-inline stgb-cta--emerald"><div><h3>{labels.contact_cta_title}</h3><p>{labels.contact_cta_text}</p></div><a href="/pricing-plans/" class="stgb-page-cta-btn">{labels.contact_cta_btn}</a></div></div></section></>:
 <div class="stgb-faq-page-body"><div class="stgb-container"><div class="stgb-faq-page-layout stgb-reveal">
<aside class="stgb-faq-page-toc"><h3>{labels.faq_categories}</h3><nav>{faqGroups.map(cat=><a href={`#category-${cat.id}`}><span>{cat.icon}</span> {cat.label}</a>)}</nav></aside>
<div class="stgb-faq-page-content">{faqGroups.map(cat=>{const items=faqItems.filter(item=>item.cat===cat.id);return items.length?<section id={`category-${cat.id}`} class="stgb-faq-page-category"><h2><span>{cat.icon}</span> {cat.label}</h2><div class="stgb-faq-page-list">{items.map((item,i)=><details class="stgb-faq-page-item" open={i===0}><summary>{item.q}</summary>{item.html?<div class="stgb-faq-page-item__answer" set:html={item.a}/>:<p>{item.a}</p>}</details>)}</div></section>:null})}</div>
</div></div>
<section class="stgb-faq-page-support stgb-reveal"><div class="stgb-container"><div class="stgb-page-cta-inline stgb-cta--emerald"><div><h3>{labels.faq_cta_title}</h3><p>{labels.faq_cta_text}</p></div><a href="/contact/" class="stgb-page-cta-btn">{labels.faq_cta_btn}</a></div></div></section></div>}
 </div>}
