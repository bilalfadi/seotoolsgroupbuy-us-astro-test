const socialIcons=Object.fromEntries(social.map(item=>[item.label.toLowerCase(),item.icon]));
const genericSocialIcon='M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71m2.25 3.27a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71';
const socialLinks=(siteSettings.social||[]).filter(item=>item.label&&item.url).map(item=>({label:item.label,href:item.url,icon:socialIcons[item.label.trim().toLowerCase()]||genericSocialIcon}));
const seoSchema=JSON.stringify({"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://seotoolsgroupbuy.us/#organization","name":"seotoolsgroupbuy.us","alternateName":"SEO Tools Group Buy","url":"https://seotoolsgroupbuy.us/","logo":{"@type":"ImageObject","url":"https://seotoolsgroupbuy.us/media/wp-uploads/2026/08/seotoolsgroupbuy-logo.webp","width":150,"height":43},"sameAs":["https://www.facebook.com/Seotoolsgroupbuy.us/"]},{"@type":"WebSite","@id":"https://seotoolsgroupbuy.us/#website","url":"https://seotoolsgroupbuy.us/","name":"Seotoolsgroupbuy.us","publisher":{"@id":"https://seotoolsgroupbuy.us/#organization"}},{"@type":"WebPage","@id":fullCanonical,"url":fullCanonical,"name":title,"description":description,"isPartOf":{"@id":"https://seotoolsgroupbuy.us/#website"},"inLanguage":"en-US"}]});
const path=Astro.url.pathname;
const excludedFromIndex=new Set(['/cart/','/checkout/','/my-account/','/access-tools/']);
const robotsDirective=excludedFromIndex.has(path)?'noindex,follow':'index,follow';
import ChatBox from '../components/ChatBox.astro';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={robotsDirective}/><link rel="icon" type="image/png" sizes="32x32" href={siteSettings.favicon}/><link rel="icon" type="image/png" sizes="192x192" href={siteSettings.favicon}/><link rel="apple-touch-icon" sizes="180x180" href={siteSettings.favicon}/><meta name="theme-color" content="#0f9c92"/><meta property="og:type" content={type==='post'?'article':'website'}/><meta property="og:site_name" content={siteSettings.brand}/><meta property="og:title" content={socialOgTitle}/><meta property="og:description" content={socialOgDescription}/><meta property="og:url" content={fullCanonical}/><meta property="og:image" content={image?(image.startsWith('http')?image:'https://seotoolsgroupbuy.us'+image):'https://seotoolsgroupbuy.us/media/wp-uploads/2026/09/ChatGPT-Image-Sep-2-2026-11_18_48-PM.png'}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={socialTwitterTitle}/><meta name="twitter:description" content={socialTwitterDescription}/><link rel="canonical" href={fullCanonical}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>{styles.map(s=><link rel="stylesheet" href={'/assets/css/'+s}/>)}<script type="application/ld+json" set:html={seoSchema}/>{structuredData.map(item=><script type="application/ld+json" set:html={JSON.stringify(item)}/>)}</head>
<body class:list={['stgb-site', type==='home'&&'home',type==='home'&&'page-template-default',type==='landing'&&'stgb-special-landing',type==='post'&&'single-post',type==='product'&&'single-product']}>
<div id="page" class="stgb-site min-h-screen flex flex-col">
{type!=='landing'&&<>
<header id="stgb-header" class="stgb-header">
  <div class="stgb-header__topbar"><div class="stgb-header__topbar-shimmer"></div><div class="stgb-container stgb-header__topbar-inner"><div class="stgb-header__topbar-links">{topbar.map(item=><a href={item.url} class="stgb-header__topbar-link">{item.label}</a>)}</div><div class="stgb-header__social">{socialLinks.map(s=><a href={s.href} target="_blank" rel="noopener noreferrer" class="stgb-header__social-link" aria-label={s.label}><svg viewBox="0 0 24 24" fill="currentColor"><path d={s.icon}/></svg></a>)}</div></div></div>
  <nav class="stgb-header__nav stgb-container" aria-label="Main navigation"><div class="stgb-header__nav-inner"><a href="/" class="stgb-header__logo"><img src={siteSettings.headerLogo} alt={siteSettings.brand} width="180" height="50"/></a><div class="stgb-header__menu">{nav.map(item=><a href={item.url} class:list={['stgb-header__menu-link',(path===item.url||(item.url==='/shop/'&&type==='product'))&&'is-active']}>{item.label}</a>)}</div><div class="stgb-header__actions"><a href={siteSettings.joinUrl} target="_blank" rel="noopener noreferrer" class="stgb-btn stgb-btn--teal">{siteSettings.joinText} <span aria-hidden="true">→</span></a><a href={siteSettings.loginUrl} target="_blank" rel="noopener noreferrer" class="stgb-btn stgb-btn--orange">{siteSettings.loginText} <span aria-hidden="true">→</span></a></div><button type="button" class="stgb-header__toggle" aria-label="Toggle menu" aria-expanded="false"><span></span><span></span><span></span></button></div></nav>
</header>
<div id="stgb-mobile-drawer" class="stgb-mobile-drawer" aria-hidden="true"><div class="stgb-mobile-drawer__backdrop"></div><div class="stgb-mobile-drawer__panel"><div class="stgb-mobile-drawer__head"><span class="stgb-mobile-drawer__title">{siteSettings.mobileMenuTitle}</span><button type="button" class="stgb-mobile-drawer__close" aria-label="Close menu">×</button></div><div class="stgb-mobile-drawer__topbar">{topbar.map(item=><a href={item.url}>{item.label}</a>)}<div class="stgb-mobile-drawer__social">{socialLinks.map(s=><a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}><svg viewBox="0 0 24 24" fill="currentColor"><path d={s.icon}/></svg></a>)}</div></div><div class="stgb-mobile-drawer__links">{nav.map(item=><a href={item.url}>{item.label}</a>)}</div><div class="stgb-mobile-drawer__cta"><a class="stgb-btn stgb-btn--teal stgb-btn--block" href={siteSettings.joinUrl} target="_blank">{siteSettings.joinText} →</a><a class="stgb-btn stgb-btn--orange stgb-btn--block" href={siteSettings.loginUrl} target="_blank">{siteSettings.loginText} →</a></div></div></div><div class="stgb-header-spacer"></div>
</>}
<main id="primary" class:list={['stgb-main',type==='home'&&'stgb-home-main',type==='product'&&'stgb-product-main',type==='archive'&&'stgb-blog-archive-main']}><slot/></main>
{type!=='landing'&&<footer class="stgb-footer"><div class="stgb-container stgb-footer__inner"><div class="stgb-footer__grid"><div class="stgb-footer__brand"><a href="/" class="stgb-footer__logo"><img src={siteSettings.footerLogo} width="180" alt={siteSettings.brand}/></a><p class="stgb-footer__desc">{siteSettings.footerDescription}</p><div class="stgb-footer__social-wrap"><p class="stgb-footer__social-title">{siteSettings.followHeading}</p><div class="stgb-footer__social">{socialLinks.map(s=><a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}><svg viewBox="0 0 24 24" fill="currentColor"><path d={s.icon}/></svg></a>)}</div></div></div><div class="stgb-footer__col"><p class="stgb-footer__heading">{siteSettings.quickLinksHeading}</p><ul>{siteSettings.quickLinks.map(item=><li><a href={item.url}>{item.label}</a></li>)}</ul></div><div class="stgb-footer__col"><p class="stgb-footer__heading">{siteSettings.supportHeading}</p><ul>{siteSettings.supportLinks.map(item=><li><a href={item.url}>{item.label}</a></li>)}</ul></div></div><div class="stgb-footer__bottom"><p class="stgb-footer__disclaimer">{siteSettings.disclaimer}</p><p>© {new Date().getFullYear()} {siteSettings.brand}. {siteSettings.copyright}</p><div class="stgb-footer__bottom-links">{siteSettings.legalLinks.map(item=><a href={item.url}>{item.label}</a>)}</div></div></div></footer>}
</div>
<ChatBox />
{scripts.map(s=><script is:inline defer src={'/assets/js/'+s}></script>)}
</body></html>
