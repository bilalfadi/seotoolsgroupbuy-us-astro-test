---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeBlogs from '../components/HomeBlogs.astro';
import {home,load} from '../lib/content.js';
import siteSettings from '../../content/site.json';
import {fixInternalLinks} from '../lib/route-fixes.js';
import {applyHomeEditor} from '../lib/home-editor.js';
import {upgradeCatalog} from '../lib/home-catalog.js';
import {upgradeBenefits} from '../lib/home-benefits.js';
import {upgradeHomeGuide} from '../lib/home-guide.js';
import {upgradeHomeFaq} from '../lib/home-faq.js';
import {upgradeHomeSupport} from '../lib/home-support.js';
const page=home();
const sourceMarkup=fixInternalLinks(applyHomeEditor(page?.content||'<h1>SEO Tools Group Buy</h1>'),siteSettings.paymentBaseUrl);
// Homepage-only decoration. CMS text, buttons, links and pricing source remain unchanged.
const heroStart='<section class="s1-hero">';
const markup=sourceMarkup.includes(heroStart)?sourceMarkup.replace(heroStart,heroStart+"<div class=\"s1-hero__decor\" aria-hidden=\"true\"><span class=\"s1-hero__float s1-hero__float--1\"><img src=\"/assets/images/hero-logos/semrush.png\" alt=\"\" loading=\"eager\"/></span><span class=\"s1-hero__float s1-hero__float--2\"><img src=\"/assets/images/hero-logos/ahrefs.png\" alt=\"\" loading=\"eager\"/></span><span class=\"s1-hero__float s1-hero__float--3\"><img src=\"/assets/images/hero-logos/chatgpt.png\" alt=\"\" loading=\"eager\"/></span><span class=\"s1-hero__float s1-hero__float--4\"><img src=\"/assets/images/hero-logos/grammarly.png\" alt=\"\" loading=\"eager\"/></span><span class=\"s1-hero__float s1-hero__float--5\"><img src=\"/assets/images/hero-logos/canva.png\" alt=\"\" loading=\"eager\"/></span><span class=\"s1-hero__float s1-hero__float--6\"><img src=\"/assets/images/hero-logos/envato-elements.png\" alt=\"\" loading=\"eager\"/></span><span class=\"s1-hero__float s1-hero__float--7\"><img src=\"/assets/images/hero-logos/moz.png\" alt=\"\" loading=\"eager\"/></span><span class=\"s1-hero__float s1-hero__float--8\"><img src=\"/assets/images/hero-logos/helium10.png\" alt=\"\" loading=\"eager\"/></span></div>").replace(/(<\/section>)/,"<div class=\"s1-hero__waves\" aria-hidden=\"true\"><svg preserveAspectRatio=\"none\" viewBox=\"0 0 1440 240\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"usHeroUpper\" x1=\"0\" x2=\"1\"><stop offset=\"0\" stop-color=\"#ffad7e\"/><stop offset=\".5\" stop-color=\"#ffead8\"/><stop offset=\"1\" stop-color=\"#ffd1a8\"/></linearGradient><linearGradient id=\"usHeroLower\" x1=\"0\" x2=\"1\"><stop offset=\"0\" stop-color=\"#f87933\"/><stop offset=\".48\" stop-color=\"#fbd7b6\"/><stop offset=\"1\" stop-color=\"#0d9488\"/></linearGradient></defs><path fill=\"#ffe0c6\" opacity=\".82\" d=\"M0 90 C180 140 220 40 380 114 C500 170 630 165 730 125 C840 95 930 190 1050 113 C1200 35 1290 140 1440 84 L1440 240 L0 240Z\"/><path fill=\"url(#usHeroUpper)\" d=\"M0 112 C140 170 190 60 340 136 C530 225 600 142 735 169 C890 203 1050 105 1174 109 C1310 121 1360 181 1440 115 L1440 240 L0 240 Z\"/><path fill=\"url(#usHeroLower)\" d=\"M0 155 C140 230 225 105 340 166 C500 227 590 201 730 199 C870 195 950 210 1080 163 C1240 104 1350 136 1440 133 L1440 240 L0 240 Z\"/></svg></div>"+'$1'):sourceMarkup;
// Derive tools from Pages CMS without editing the source content.
const catalogMarkup=upgradeHomeSupport(upgradeHomeFaq(upgradeHomeGuide(upgradeBenefits(upgradeCatalog(markup,load('products'))))));
const shortcode='[stgb_home_blogs]';
const pos=catalogMarkup.indexOf(shortcode);
const before=pos<0?catalogMarkup:catalogMarkup.slice(0,pos);
const after=pos<0?'':catalogMarkup.slice(pos+shortcode.length);
---
<SiteLayout title={page?.seoTitle||'SEO Tools Group Buy'} description={page?.seoDescription||page?.excerpt||'Affordable access to premium digital marketing tools'} image={page?.featuredImage||''} type="home">
  <Fragment set:html={before} />
  {pos>=0&&<HomeBlogs />}
  {pos>=0&&<Fragment set:html={after}/>}
</SiteLayout>
