---
import SiteLayout from '../layouts/SiteLayout.astro';
import ToolsMarketplace from '../components/ToolsMarketplace.astro';
import BlogPostPage from '../components/BlogPostPage.astro';
import LandingPage from '../components/LandingPage.astro';
import ContentPage from '../components/ContentPage.astro';
import RelatedProducts from '../components/RelatedProducts.astro';
import labels from '../lib/site-default-copy.json';
import {productPrice,formatProductPrice,productCategoryName,relatedProducts} from '../lib/catalog.js';
import {all,load,url} from '../lib/content.js';
import {redirects,fixInternalLinks} from '../lib/route-fixes.js';
export function getStaticPaths(){return [...all().filter(x=>x.slug!=='home').map(entry=>({params:{slug:entry.slug},props:{entry}})),...Object.entries(redirects).map(([from,to])=>({params:{slug:from},props:{redirectTo:to}}))]}
const {entry,redirectTo}=Astro.props;
if(redirectTo){return Astro.redirect('/'+redirectTo+'/',301);}
entry.content=fixInternalLinks(entry.content);
entry.shortDescription=fixInternalLinks(entry.shortDescription);
const title=entry.seoTitle||entry.title;
const desc=entry.seoDescription||String(entry.excerpt||'').replace(/<[^>]+>/g,' ').slice(0,160);
const products=load('products');
const isShop=['shop','single-tools-list','tools'].includes(entry.slug);
const isProduct=entry.type==='product';
const isAccount=['cart','checkout','my-account'].includes(entry.slug);
const clean=s=>String(s||'').replace(/<[^>]*>/g,' ').replace(/\s+/g,' ').trim();
const esc=s=>String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const formatPrice=s=>/^\d/.test(String(s||''))?'$'+s:String(s||'');
const buy=entry.externalUrl||'';
const category=productCategoryName(entry).toUpperCase();
const pricing=productPrice(entry);
const related=isProduct?relatedProducts(entry,products,4):[];
const special=false; // Current WordPress site uses regular WooCommerce product detail for Ahrefs and Semrush
---
<SiteLayout title={title} description={desc} canonical={url(entry.slug)} image={entry.featuredImage} type={special?"landing":entry.type}>
{special ? <LandingPage entry={entry} landing={entry.slug==='ahrefs'?'ahrefs':'semrush'} /> : isShop ? <ToolsMarketplace /> : isAccount ? <section class="stgb-container stgb-migration-notice"><h1>{entry.title}</h1><p>Account and checkout continue through the existing members platform.</p><a href="https://seogroupsbuy.com/users/login" class="stgb-btn stgb-btn--teal">Open member login</a></section> : isProduct ? <article class="stgb-product-detail"><section class="stgb-product-detail__hero"><div class="stgb-container"><div class="stgb-product-detail__hero-grid"><div class="stgb-product-detail__media"><div class="stgb-product-detail__logo-box">{entry.featuredImage?<img class="stgb-product-detail__logo-img" src={entry.featuredImage} alt={entry.featuredAlt||entry.title}/>:<div class="stgb-product-detail__logo-fallback">{entry.title.slice(0,2)}</div>}</div></div><div class="stgb-product-detail__intro"><p class="stgb-product-detail__category">{category}</p><h1 class="stgb-product-detail__title">{entry.title}</h1>{entry.shortDescription&&<div class="stgb-product-detail__short" set:html={entry.shortDescription}/>}<div class="stgb-product-detail__price-row">{pricing.onSale&&<span class="stgb-product-detail__price-old">{formatProductPrice(pricing.regular)}</span>}{pricing.current&&<span class="stgb-product-detail__price-current">{formatProductPrice(pricing.current)}</span>}<span class="stgb-product-detail__price-label">{labels.price_label_detail||'Per month'}</span></div>{buy&&<a href={buy} target="_blank" rel="noopener noreferrer" class="stgb-btn stgb-btn--emerald stgb-product-detail__hero-buy">{entry.buttonText||'Buy Now'}</a>}</div></div></div></section><section class="stgb-product-detail__body"><div class="stgb-container"><div id="product-detail-section" class="stgb-product-detail__layout"><div id="product-detail-content" class="stgb-product-detail__main"><div class="stgb-rich-shell"><div class="stgb-rich-shell__inner"><div class="stgb-product-detail__desc-head"><span class="stgb-product-detail__desc-bar"></span><span class="stgb-product-detail__desc-label">Description</span><span class="stgb-product-detail__desc-line"></span></div><article class="product-description"><div class="stgb-product-detail__content-html" set:html={entry.content}/></article></div></div></div><aside class="stgb-product-detail__aside"><div class="stgb-product-detail__sidebar"><div class="stgb-product-detail__sidebar-price"><p class="stgb-product-detail__sidebar-label">{labels.price_label_detail||'Per month'}</p><p class="stgb-product-detail__sidebar-amount">{formatProductPrice(pricing.current)}</p>{pricing.onSale&&<p class="stgb-product-detail__sidebar-old">{formatProductPrice(pricing.regular)}</p>}</div>{buy&&<a href={buy} target="_blank" rel="noopener noreferrer" class="stgb-btn stgb-btn--emerald stgb-btn--block stgb-product-detail__sidebar-buy">{entry.buttonText||'Buy Now'}</a>}</div></aside></div></div></section><RelatedProducts products={related}/></article> : entry.type==='post' ? <BlogPostPage entry={entry}/> : <ContentPage entry={entry}/>}
</SiteLayout>
