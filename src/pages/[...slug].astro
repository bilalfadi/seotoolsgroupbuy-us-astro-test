---
import SiteLayout from '../layouts/SiteLayout.astro';
import siteSettings from '../../content/site.json';
import ToolsMarketplace from '../components/ToolsMarketplace.astro';
import BlogPostPage from '../components/BlogPostPage.astro';
import LandingPage from '../components/LandingPage.astro';
import ContentPage from '../components/ContentPage.astro';
import RelatedProducts from '../components/RelatedProducts.astro';
import labels from '../lib/site-default-copy.json';
import {productPrice,formatProductPrice,productCategoryName,relatedProducts} from '../lib/catalog.js';
import {prepareEditorContentHeadings,productLogoData} from '../lib/legacy-render.js';
import {all,load,url} from '../lib/content.js';
import {fixInternalLinks,purchaseLink} from '../lib/route-fixes.js';
import {repairLinkedProductImages} from '../lib/repair-media.js';
import {seoSchemaForEntry} from '../lib/seo-schema.js';
export function getStaticPaths(){return all().filter(x=>x.slug!=='home').map(entry=>({params:{slug:entry.slug},props:{entry}}))}
const {entry}=Astro.props;
entry.content=fixInternalLinks(entry.content,siteSettings.paymentBaseUrl);
entry.shortDescription=fixInternalLinks(entry.shortDescription,siteSettings.paymentBaseUrl);
const title=entry.seoTitle||entry.title;
const desc=entry.seoDescription||String(entry.excerpt||'').replace(/<[^>]+>/g,' ').slice(0,160);
const products=load('products');
entry.content=repairLinkedProductImages(entry.content,products);
const isShop=['shop','single-tools-list','tools'].includes(entry.slug);
const isProduct=entry.type==='product';
const isAccount=['cart','checkout','my-account'].includes(entry.slug);
const clean=s=>String(s||'').replace(/<[^>]*>/g,' ').replace(/\s+/g,' ').trim();
const esc=s=>String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const formatPrice=s=>/^\d/.test(String(s||''))?'$'+s:String(s||'');
const buy=purchaseLink(entry.externalUrl,siteSettings.paymentBaseUrl);
const category=productCategoryName(entry).toUpperCase();
const pricing=productPrice(entry);
const related=isProduct?relatedProducts(entry,products,4):[];
const structuredData=seoSchemaForEntry(entry,products);
const descriptionHtml=isProduct?prepareEditorContentHeadings(entry.title,entry.content):entry.content;
const logoData=productLogoData(entry.title);
// Keep original WooCommerce product layout until the editor explicitly opts in.
const special=Boolean(entry.enableCustomLanding)&&['ahrefs','semrush'].includes(entry.slug);
---
<SiteLayout title={title} description={desc} canonical={url(entry.slug)} image={entry.featuredImage} type={special?"landing":entry.type} structuredData={structuredData}>
{special ? <LandingPage entry={entry} landing={entry.slug==='ahrefs'?'ahrefs':'semrush'} /> : isShop ? <ToolsMarketplace /> : isAccount ? <section class="stgb-container stgb-migration-notice"><h1>{entry.title}</h1><p>Account and checkout continue through the existing members platform.</p><a href={siteSettings.loginUrl} class="stgb-btn stgb-btn--teal">Open member login</a></section> : isProduct ? <article class="stgb-product-detail"><section class="stgb-product-detail__hero"><div class="stgb-container"><div class="stgb-product-detail__hero-grid"><div class="stgb-product-detail__media"><div class="stgb-product-detail__logo-box">{entry.featuredImage?<img class="stgb-product-detail__logo-img" src={entry.featuredImage} alt={entry.featuredAlt||entry.title}/>:<div class="stgb-product-detail__logo-fallback" style={`background-color:${logoData.color}`}>{logoData.initials}</div>}</div></div><div class="stgb-product-detail__intro"><p class="stgb-product-detail__category">{category}</p><h1 class="stgb-product-detail__title">{entry.title}</h1>{entry.shortDescription&&<div class="stgb-product-detail__short" set:html={entry.shortDescription}/>}<div class="stgb-product-detail__price-row">{pricing.onSale&&<span class="stgb-product-detail__price-old">{formatProductPrice(pricing.regular)}</span>}{pricing.current&&<span class="stgb-product-detail__price-current">{formatProductPrice(pricing.current)}</span>}<span class="stgb-product-detail__price-label">{labels.price_label_detail||'Per month'}</span></div>{buy&&<a href={buy} target="_blank" rel="noopener noreferrer" class="stgb-btn stgb-btn--emerald stgb-product-detail__hero-buy">{entry.buttonText||'Buy Now'}</a>}</div></div></div></section><section class="stgb-product-detail__body"><div class="stgb-container"><div id="product-detail-section" class="stgb-product-detail__layout"><div id="product-detail-content" class="stgb-product-detail__main"><div class="stgb-rich-shell"><div class="stgb-rich-shell__inner"><div class="stgb-product-detail__desc-head"><span class="stgb-product-detail__desc-bar"></span><span class="stgb-product-detail__desc-label">Description</span><span class="stgb-product-detail__desc-line"></span></div><article class="product-description"><div class="stgb-product-detail__content-html" set:html={descriptionHtml}/></article></div></div></div><aside class="stgb-product-detail__aside"><div class="stgb-product-detail__sidebar"><div class="stgb-product-detail__sidebar-price"><p class="stgb-product-detail__sidebar-label">{labels.price_label_detail||'Per month'}</p><p class="stgb-product-detail__sidebar-amount">{formatProductPrice(pricing.current)}</p>{pricing.onSale&&<p class="stgb-product-detail__sidebar-old">{formatProductPrice(pricing.regular)}</p>}</div>{buy&&<a href={buy} target="_blank" rel="noopener noreferrer" class="stgb-btn stgb-btn--emerald stgb-btn--block stgb-product-detail__sidebar-buy">{entry.buttonText||'Buy Now'}</a>}</div></aside></div></div></section><RelatedProducts products={related}/></article> : entry.type==='post' ? <BlogPostPage entry={entry}/> : <ContentPage entry={entry}/>}
</SiteLayout>
